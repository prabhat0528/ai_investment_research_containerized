# Server Port Configuration
PORT=5000

# Local PostgreSQL Database Configuration (Docker Compose DB Container)
DATABASE_URL=postgresql://postgres:postgres@db:5432/quantterminal
DATABASE_SSL=false

# Authentication Secret Key
JWT_SECRET=your_jwt_secret_here

# Primary AI Model API Key (Google Gemini SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary & Backup AI Model API Keys (Key Rotation Pool)
NOTIFICATIONS_GEMINI_KEY=your_gemini_api_key_here
NOTIFICATIONS_GEMINI_KEY_BACKUP_1=your_backup_gemini_api_key_1
NOTIFICATIONS_GEMINI_KEY_BACKUP_2=your_backup_gemini_api_key_2
MAIN_GEMINI_KEY_BACKUP_1=your_backup_gemini_api_key_1
MAIN_GEMINI_KEY_BACKUP_2=your_backup_gemini_api_key_2

# Backup AI Model Provider (Groq API Key for Llama 3.3 Fallback)
GROQ_API_KEY=your_groq_api_key_here

# Real-time Stock Provider API Key (Finnhub client)
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here
