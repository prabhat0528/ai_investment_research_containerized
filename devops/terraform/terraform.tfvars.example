# Example Terraform Variables File
# Rename to terraform.tfvars and customize with your parameters

aws_region         = "us-east-1"
environment        = "prod"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "us-east-1a"
instance_type      = "t3.small"
ssh_key_name       = "ai-investment-key"
dockerhub_user     = "prabhatrai05"
allowed_ssh_cidr   = "0.0.0.0/0" # Replace with your public IP, e.g. "203.0.113.45/32"
